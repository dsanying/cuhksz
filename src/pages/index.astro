---
import PortalLayout from '../layouts/PortalLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = [
  { no: '01', title: '新生落地', text: '从报到清单、书院生活到校园地图，把第一周的慌乱变成可执行的路径。', href: '/checklist/', label: '入学清单' },
  { no: '02', title: '学业导航', text: '课程资料、选修建议、转专业、SIS 与学习空间，按实际问题快速抵达。', href: '/course/', label: '课程与学业' },
  { no: '03', title: '校园生活', text: '地图、交通、医保、联系方式、周边生活——需要的时候，答案就在这里。', href: '/map/', label: '探索校园' },
  { no: '04', title: '资源网络', text: '社群、媒体与重要资料入口，把分散的信息重新连成一张可靠的网。', href: '/social/', label: '资源与社群' },
];
---

<PortalLayout description="面向港中深学生的课程、校园与生活资源导航。">
  <section class="hero">
    <div class="hero-copy reveal">
      <p class="eyebrow">CUHK-SHENZHEN · STUDENT FIELD GUIDE</p>
      <h1>少一点<br /><i>找路</i>，多一点<br />在这里生活。</h1>
      <p class="hero-intro">给刚到深圳、正在选课、准备办事，或只是想把校园过得更明白的你。</p>
      <div class="hero-actions">
        <a class="button-primary" href={`${base}/checklist/`}>打开新生路线 <span>→</span></a>
        <a class="text-link" href={`${base}/map/`}>先看看校园地图 <span>↗</span></a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="sun"></div>
      <div class="lake"></div>
      <div class="ridge ridge-one"></div>
      <div class="ridge ridge-two"></div>
      <div class="map-pin pin-one">SIS</div>
      <div class="map-pin pin-two">湖畔</div>
      <p class="coordinates">22° 41′ N &nbsp; · &nbsp; 114° 14′ E</p>
    </div>
  </section>

  <section id="explore" class="explore-section">
    <div class="section-heading">
      <p class="eyebrow">FIND YOUR WAY</p>
      <h2>从你现在的问题开始</h2>
      <p>不是按“文章”堆叠，而是按学生真正要完成的事组织。</p>
    </div>
    <div class="route-grid">
      {sections.map((section) => (
        <a class="route-card" href={`${base}${section.href}`}>
          <span class="route-no">{section.no}</span>
          <span class="route-arrow">↗</span>
          <h3>{section.title}</h3>
          <p>{section.text}</p>
          <span class="route-label">{section.label}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="feature-strip">
    <div><span>校园地图</span><strong>导览图 + 官方 VR</strong></div>
    <a href={`${base}/map/`} aria-label="打开校园地图">探索 <span>→</span></a>
  </section>

  <section class="latest-section">
    <div class="section-heading compact">
      <p class="eyebrow">MOST USEFUL</p>
      <h2>先从这些开始</h2>
    </div>
    <div class="latest-list">
      <a href={`${base}/guide-lgu-2/`}><span>01</span><strong>如何快速高效地上手 SIS</strong><em>学业与课程</em><b>→</b></a>
      <a href={`${base}/guide-lgu-3/`}><span>02</span><strong>跨学院转专业攻略</strong><em>学业与课程</em><b>→</b></a>
      <a href={`${base}/medical-insurance/`}><span>03</span><strong>港中深医保指南</strong><em>新生与校园</em><b>→</b></a>
      <a href={`${base}/guide-lgu-6/`}><span>04</span><strong>教科书与论文文献获取指南</strong><em>学习工具</em><b>→</b></a>
    </div>
  </section>
</PortalLayout>
